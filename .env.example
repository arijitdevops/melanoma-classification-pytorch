# Copy this file to .env and adjust the values for your machine.
# Every variable below is optional; the defaults shown are what the code uses.

# Root of the dataset. Must contain train/{Benign,Malignant} and test/{Benign,Malignant}.
DATA_DIR=../_datasets/melanoma_skin_cancer

# Checkpoint loaded by evaluate.py, predict.py, gradcam.py, export_onnx.py and the Flask app.
CHECKPOINT_PATH=checkpoints/best.pt

# YAML configuration file loaded by src.config.load_config().
CONFIG_PATH=configs/default.yaml

# Compute device: cuda, mps, cpu, or auto to pick the best available.
DEVICE=auto

# DataLoader worker processes. Use 0 on Windows if you hit multiprocessing errors.
NUM_WORKERS=4

# Global seed for random, numpy and torch.
RANDOM_SEED=42

# Flask environment: development enables the debugger and reloader.
FLASK_ENV=production

# Secret key for Flask sessions and flash messages. Change this for any real deployment.
SECRET_KEY=change-me-in-production

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
